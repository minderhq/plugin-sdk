      },
      "expected": {
        "content_digest": "sha-256=:47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=:",
        "signature_input": "sig1=(\"@method\" \"@authority\" \"@path\" \"@query\" \"content-digest\");created=1760000200;nonce=\"t4-vector-nonce-0003\";keyid=\"poqkLGiymh_W0uP6PZFw-dvez3QJT5SolqXBCW38r0U\";alg=\"ed25519\"",
        "signature_base": "\"@method\": GET\n\"@authority\": plugin.example.com:8443\n\"@path\": /minder/v1/health\n\"@query\": ?probe=1&x=%20\n\"content-digest\": sha-256=:47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=:\n\"@signature-params\": (\"@method\" \"@authority\" \"@path\" \"@query\" \"content-digest\");created=1760000200;nonce=\"t4-vector-nonce-0003\";keyid=\"poqkLGiymh_W0uP6PZFw-dvez3QJT5SolqXBCW38r0U\";alg=\"ed25519\"",
        "signature": "sig1=:IMPWNaM4+sbcDnGE/aYr0GrgYftc8epKNuGvC8fROuwreLiqh8r4PWJUAC9CIuXM0K55hQ/pbFNAj7H2cODfBw==:"
